; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Addons]

ButtonPrompts/prompts/light_themed_keyboard_and_mouse=false
ButtonPrompts/prompts/positional_controller_button_prompts=false
ButtonPrompts/optional_supported_controllers/dualshock_4=true
ButtonPrompts/optional_supported_controllers/dualshock_3=true
ButtonPrompts/optional_supported_controllers/xbox_one=true
ButtonPrompts/optional_supported_controllers/xbox_360=true
ButtonPrompts/optional_supported_controllers/steam_deck=true
ButtonPrompts/optional_supported_controllers/nintendo_switch=true

[animation]

warnings/check_invalid_track_paths=false

[application]

config/name="Soul Framework"
config/version="0.1"
run/main_scene="uid://nuu4xy5dig7q"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=120
boot_splash/bg_color=Color(0, 0, 0, 1)

[audio]

buses/default_bus_layout="uid://3fcv2aotmxxl"
general/default_playback_type.web=0

[autoload]

AudioManage="*res://Engine/Managers/Audio/audio_managed.tscn"
UiSoundManager="*res://Engine/Managers/Audio/ui_sound_manager.tscn"
MusicSoundManager="*uid://jrc6kpj1x1fe"
button_prompts_manager="*uid://cy31x45v8vmkc"
MaterialAnim="*uid://mrs3mnaxwmvl"
Hlp="*uid://d1ddyns6k558c"
InputMan="*uid://44il57jlcr0e"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/stretch/mode="viewport"
window/vsync/vsync_mode=0
mouse_cursor/custom_image="uid://vdckvap8ll4o"

[editor_plugins]

enabled=PackedStringArray("res://addons/button_prompts_for_godot/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://Engine/": "green",
"res://Engine/Enviroments/": "teal"
}

